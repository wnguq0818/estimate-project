{% set R = d.report %}{% set O = d.office %}{% set CX = d.complex %}{% set SC = d.sales_comparison %}{% set INC = d.income %}{% set CI = c.income %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>감정평가서 {{ R.number }} — {{ O.name }}</title>
<style>
@page { size: A4; margin: 0; }
:root {
  --brand: #16443a;      /* 경율 딥그린 */
  --brand-2: #2b6b5c;
  --accent: #a8873a;     /* 골드 포인트 */
  --line: #3a3a3a;
  --soft: #e7eeeb;       /* 표 머리 */
  --soft-2: #f4f7f5;
  --total: #fbf3dd;      /* 합계 강조 */
  --ink: #1b1b1b;
  --muted: #666;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: #8a8f8d; }
body {
  font-family: 'NanumSquare', 'NanumBarunGothic', 'Nanum Gothic', 'Noto Sans KR', 'Malgun Gothic', 'Noto Sans CJK KR', 'WenQuanYi Zen Hei', sans-serif;
  color: var(--ink); font-size: 10pt; line-height: 1.55;
  -webkit-print-color-adjust: exact; print-color-adjust: exact;
}
.page {
  width: 210mm; height: 297mm; margin: 0 auto 8mm; background: #fff;
  position: relative; overflow: hidden; padding: 14mm 17mm 20mm;
  page-break-after: always; break-after: page;
}
.page:last-child { page-break-after: auto; break-after: auto; }
@media print { html, body { background: #fff; } .page { margin: 0; } }

/* 공통 머리/꼬리 */
.docno { font-size: 8.5pt; color: var(--muted); letter-spacing: .02em; display: flex; justify-content: space-between; align-items: center; }
.docno .brandmini { color: var(--brand); font-weight: 700; letter-spacing: .08em; }
.pfoot { position: absolute; left: 17mm; right: 17mm; bottom: 10mm; border-top: 1.5px solid var(--brand); padding-top: 2mm;
  display: flex; justify-content: space-between; font-size: 8pt; color: var(--muted); }
.pfoot .pn { color: var(--ink); font-weight: 700; }

.form-title { text-align: center; font-size: 21pt; font-weight: 800; letter-spacing: .06em; margin: 9mm 0 4mm; }
.rule { height: 5px; display: flex; margin-bottom: 4mm; }
.rule i:first-child { flex: 0 0 22%; background: var(--brand); }
.rule i:last-child  { flex: 1; background: var(--accent); opacity: .55; }

.opbar { margin-top: 3mm; background: var(--brand); color: #fff; font-size: 15pt; font-weight: 700; letter-spacing: .12em;
  padding: 2.2mm 4mm; border-bottom: 3px solid var(--accent); }
.opbody { padding: 2mm 2mm 0; }

h2.chap { font-size: 15pt; font-weight: 800; margin: 7mm 0 5mm; padding-bottom: 1.2mm; border-bottom: 1.5px solid var(--brand); color: var(--brand); }
h3.sec { font-size: 11.5pt; font-weight: 800; margin: 6mm 0 2.5mm; }
h4.sub { font-size: 10.5pt; font-weight: 800; margin: 5mm 0 2mm; }
h5.ssub { font-size: 10pt; font-weight: 700; margin: 4mm 0 2mm; }
p { margin: 1.5mm 0; text-align: justify; }
.ind { padding-left: 4mm; }
ol.paren { margin: 1mm 0; padding-left: 0; list-style: none; }
ol.paren li { padding-left: 7mm; text-indent: -7mm; margin: 1.5mm 0; }
.src { text-align: right; font-size: 8.5pt; color: var(--muted); margin: 1mm 0 1mm; }
.note { font-size: 9pt; margin: 1.5mm 0; }
.bullet { font-size: 9.5pt; margin: 2mm 0 1mm; }
.bullet::before { content: '■ '; color: var(--brand); }
.hl { font-weight: 800; text-decoration: underline; text-underline-offset: 2px; }
.formula { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); text-align: center; padding: 2.5mm; margin: 3mm 0; font-weight: 700; background: var(--soft-2); }

/* 표 */
table { border-collapse: collapse; width: 100%; }
.tbl { font-size: 9pt; margin: 1mm 0 2mm; }
.tbl th, .tbl td { border: 1px solid #9aa5a1; padding: 1.4mm 1.5mm; text-align: center; vertical-align: middle; }
.tbl th { background: var(--soft); font-weight: 700; }
.tbl { border-top: 2px solid var(--brand); border-bottom: 1.5px solid var(--brand); }
.tbl tr.total td, .tbl tr.total th { background: var(--total); font-weight: 800; }
.tbl td.l { text-align: left; }
.tbl td.r { text-align: right; }
.tbl td.pre { white-space: pre-line; }

/* 표지 */
.cover { padding: 0; }
.cover .frame { position: absolute; inset: 12mm; border: 1px solid var(--brand); }
.cover .frame::after { content: ''; position: absolute; inset: 1.6mm; border: .5px solid var(--accent); }
.cover .band { position: absolute; left: 12mm; right: 12mm; top: 12mm; height: 10mm; background: var(--brand); }
.cover .band::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2mm; height: 2mm; background: var(--accent); }
.cover .inner { position: absolute; inset: 12mm; padding: 34mm 22mm 0; }
.cover h1 { margin: 0; text-align: center; font-size: 40pt; font-weight: 800; letter-spacing: .55em; padding-left: .55em; }
.cover .en { text-align: center; font-size: 15pt; font-weight: 700; letter-spacing: .25em; color: var(--brand); margin-top: 3mm; }
.cover .meta { margin: 20mm 8mm 0; border-top: 2px solid var(--brand); border-bottom: 2px solid var(--accent); padding: 6mm 4mm; }
.cover .meta table td { padding: 2.6mm 1mm; font-size: 11.5pt; vertical-align: top; }
.cover .meta td.k { width: 30mm; font-weight: 700; color: var(--brand); white-space: nowrap; }
.cover .meta td.k span { display: inline-block; width: 22mm; text-align: justify; text-align-last: justify; }
.cover .meta td.v { font-weight: 700; }
.cover .notice { position: absolute; left: 34mm; right: 34mm; bottom: 66mm; border: 1px solid #888; padding: 3mm 4mm; font-size: 9pt; text-align: center; line-height: 1.7; color: #333; }
.cover .office { position: absolute; left: 0; right: 0; bottom: 26mm; text-align: center; }
.cover .office .name { font-size: 18pt; font-weight: 800; letter-spacing: .08em; }
.cover .office .name em { font-style: normal; color: var(--brand); }
.cover .office .contact { margin-top: 3mm; font-size: 9.5pt; font-weight: 700; color: #333; letter-spacing: .03em; }
.cover .office .contact span + span { margin-left: 6mm; }

/* 감정평가표 */
.form { border: 1.5px solid var(--line); }
.form td, .form th { border: 1px solid #555; padding: 1.8mm 1.5mm; text-align: center; font-size: 9.6pt; }
.form th { background: var(--soft); font-weight: 700; }
.oath { border: 1.5px solid var(--line); padding: 4mm 6mm 3mm; margin-bottom: 1.5mm; font-size: 10.2pt; line-height: 1.9; }
.oath p { text-indent: 2.5mm; margin: 0; text-align: justify; }
.sign { display: flex; justify-content: flex-end; align-items: center; gap: 6mm; margin-top: 3mm; }
.sign .who { text-align: center; line-height: 1.8; }
.sign .who b { letter-spacing: .3em; }
.seal { width: 19mm; height: 19mm; border: 1.2px dashed #c0392b; border-radius: 50%; color: #c0392b; display: flex; align-items: center; justify-content: center; font-size: 9pt; }
.hj { font-family: 'NanumGothic', 'WenQuanYi Zen Hei', serif; font-weight: 400; }
.seal img, .sigimg img { max-width: 100%; max-height: 100%; }
.sigimg { width: 38mm; height: 16mm; border-bottom: 1px solid #999; display: flex; align-items: flex-end; justify-content: center; color: #aaa; font-size: 8pt; }
.amount { background: var(--total); font-size: 13pt !important; font-weight: 800; text-align: left !important; padding-left: 4mm !important; }
.vert { writing-mode: vertical-rl; letter-spacing: 1.2em; font-weight: 700; background: var(--soft); }
.ihy { letter-spacing: 3.2em; color: #333; }

/* 명세표 */
.spec td { word-break: keep-all; border-left: 1px solid #555; border-right: 1px solid #555; border-top: 0; border-bottom: 0; font-size: 9pt; padding: .6mm 1.2mm; text-align: center; vertical-align: top; }
.spec th { border: 1px solid #555; background: var(--soft); font-size: 9pt; padding: 1.2mm; }
.spec { border: 1.5px solid var(--line); }
.spec td.r { text-align: right; }
.spec td.l { text-align: left; }
.spec tr.total td { background: var(--total); border-top: 1px solid #555; border-bottom: 1px solid #555; font-weight: 800; padding: 1.5mm; vertical-align: middle; }
.spec tr.fill td { height: 100%; }

/* 위치도·사진 */
.mapbox { border: 1px solid var(--line); height: 198mm; display: flex; align-items: center; justify-content: center; background: var(--soft-2); overflow: hidden; }
.mapbox img { width: 100%; height: 100%; object-fit: cover; }
.ph { color: #8a9692; font-size: 10pt; text-align: center; line-height: 1.8; }
.legend { display: flex; justify-content: center; gap: 4mm; margin-top: 4mm; font-size: 9pt; }
.legend span { border: 1px solid #bbb; padding: 1.2mm 6mm; box-shadow: 1px 1px 0 #ddd; }
.photos { border: 1px solid var(--line); padding: 6mm 14mm; height: 236mm; display: flex; flex-direction: column; justify-content: space-around; }
.photo { text-align: center; }
.photo .frame { height: 92mm; border: 3px solid #9aa5a1; display: flex; align-items: center; justify-content: center; background: var(--soft-2); overflow: hidden; }
.photo .frame img { width: 100%; height: 100%; object-fit: cover; }
.grid4 { display: grid; grid-template-columns: 1fr 1fr; gap: 10mm 4mm; margin-top: 8mm; }
.grid4 .gh { background: var(--brand); color: #fff; text-align: center; padding: 1.6mm; font-weight: 700; border-bottom: 2px solid var(--accent); }
.grid4 .frame { height: 82mm; background: var(--soft-2); display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid #9aa5a1; border-top: 0; }
.grid4 .frame img { width: 100%; height: 100%; object-fit: cover; }
.photo .cap { margin-top: 2mm; text-decoration: underline; text-underline-offset: 3px; font-weight: 700; }
</style>
</head>
<body>

{# ============================================================ 표지 #}


<section class="page cover">
  <div class="frame"></div><div class="band"></div>
  <div class="inner">
    <h1>감정평가서</h1>
    <div class="en">APPRAISAL REPORT</div>
    <div class="meta">
      <table>
        <tr><td class="k"><span>건명</span> :</td><td class="v">{{ R.title }}</td></tr>
        <tr><td class="k"><span>의뢰인</span> :</td><td class="v">{{ R.client }}</td></tr>
        <tr><td class="k"><span>감정서번호</span> :</td><td class="v">{{ R.number }}</td></tr>
        <tr><td class="k"><span>기준시점</span> :</td><td class="v">{{ R.base_date|long_date }}</td></tr>
      </table>
    </div>
  </div>
  <div class="notice">
    이 감정평가서는 감정평가 의뢰목적 외의 목적에 사용하거나<br>
    타인(의뢰인 또는 제출처가 아닌 자)이 사용할 수 없을 뿐 아니라<br>
    복사, 개작(<span class="hj">改作</span>), 전재(<span class="hj">轉載</span>)할 수 없으며 이로 인한 결과에 대하여<br>
    감정평가법인등은 책임을 지지 않습니다.
  </div>
  <div class="office">
    <div class="name">감정평가사사무소 <em>{{ O.name_short }}</em></div>
    <div class="contact"><span>TEL. {{ O.tel }}</span>{% if O.mobile %}<span>H.P. {{ O.mobile }}</span>{% endif %}{% if O.fax %}<span>FAX. {{ O.fax }}</span>{% endif %}</div>
    <div class="contact" style="font-weight:400;margin-top:1mm">{{ O.address }}</div>
  </div>
</section>

{# ============================================================ 감정평가표 #}
<section class="page">
  <div class="docno"><span>{{ R.number }}</span><span class="brandmini">{{ O.name }}</span></div>
  <div class="form-title">({{ R.property_kind }}) 감정평가표</div>
  <div class="rule"><i></i><i></i></div>

  <div class="oath">
    <p>본인은 감정평가에 관한 법규를 준수하고 감정평가이론에 따라 성실하고 공정하게 이 감정평가서를 작성하였기에 서명날인합니다.</p>
    <div class="sign">
      <div class="who"><b>감정평가사</b><br>{{ O.appraiser }}</div>
      <div class="sigimg">{% if img(O.signature_image) %}<img src="{{ img(O.signature_image) }}">{% else %}(서명){% endif %}</div>
      <div class="seal">{% if img(O.seal_image) %}<img src="{{ img(O.seal_image) }}">{% else %}(인){% endif %}</div>
    </div>
  </div>

  <table class="form">
    <colgroup><col style="width:9mm"><col style="width:22mm"><col><col style="width:12mm"><col style="width:27mm"><col style="width:27mm"><col style="width:27mm"></colgroup>
    <tr><th colspan="2">감정평가액</th><td colspan="5" class="amount">{{ c.final_korean }}원정 (₩{{ c.final|won }}.-)</td></tr>
    <tr><th colspan="2">의 뢰 인</th><td colspan="2">{{ R.client }}</td><th>감정평가 목적</th><td colspan="2">{{ R.purpose }}</td></tr>
    <tr><th colspan="2">제 출 처</th><td colspan="2">{{ R.submit_to }}</td><th>기 준 가 치</th><td colspan="2">{{ R.value_basis }}</td></tr>
    <tr><th colspan="2">소 유 자<br><small>(대상업체명)</small></th><td colspan="2">{{ R.owner }}</td><th>감정평가조건</th><td colspan="2">{{ R.conditions }}</td></tr>
    <tr><th colspan="2" rowspan="2">물건목록<br>표시근거</th><td colspan="2" rowspan="2" class="pre" style="white-space:pre-line;font-size:9pt">{{ R.basis_docs }}</td><th>기 준 시 점</th><th>조 사 기 간</th><th>작 성 일</th></tr>
    <tr style="white-space:nowrap"><td>{{ R.base_date|dotted }}</td><td>{{ R.survey_date|dotted }}</td><td>{{ R.written_date|dotted }}</td></tr>
    <tr><th colspan="2">기타 참고사항</th><td colspan="5" class="l" style="text-align:left">{{ R.other_notes or '' }}</td></tr>
  </table>

  <table class="form" style="margin-top:-1.5px">
    <colgroup><col style="width:9mm"><col style="width:22mm"><col style="width:26mm"><col style="width:22mm"><col style="width:26mm"><col style="width:22mm"><col></colgroup>
    <tr><td rowspan="{{ 3 + 5 }}" class="vert">평가내용</td><th colspan="2">공부(<span class="hj">公簿</span>)(의뢰)</th><th colspan="2">사 정</th><th colspan="2">감 정 평 가 액</th></tr>
    <tr><th>종 류</th><th>면적 또는 수량(㎡)</th><th>종 류</th><th>면적 또는 수량(㎡)</th><th>단 가</th><th>금 액</th></tr>
    <tr style="height:12mm"><td>{{ R.property_kind }}</td><td class="r" style="text-align:right">{{ d.units|length }}{{ R.unit_word or '개호' }}</td><td>{{ R.property_kind }}</td><td style="text-align:right">{{ d.units|length }}{{ R.unit_word or '개호' }}</td><td>-</td><td style="text-align:right">{{ c.final|won }}</td></tr>
    <tr style="height:12mm"><td></td><td colspan="4"><span class="ihy">이하여백</span></td><td></td></tr>
    {% for i in range(3) %}<tr style="height:12mm"><td></td><td></td><td></td><td></td><td></td><td></td></tr>{% endfor %}
    <tr class="total"><th>합 계</th><td></td><td></td><td></td><td></td><td class="amount" style="text-align:right !important;font-size:10.5pt !important">₩{{ c.final|won }}.-</td></tr>
  </table>

  <table class="form" style="margin-top:2mm">
    <tr><td style="height:34mm;text-align:left;vertical-align:top;padding:5mm 8mm">
      <b>감정평가액의 산출근거 및 결정의견</b>
      <div style="text-align:center;margin-top:10mm;letter-spacing:2.2em;font-weight:700">"별지참조"</div>
    </td></tr>
  </table>
</section>

{# ============================================================ 명세표 #}
<section class="page">
  <div class="docno"><span>{{ R.number }}</span><span class="brandmini">{{ O.name }}</span></div>
  <div class="form-title">({{ R.property_kind }}) 감정평가명세표</div>
  <div class="rule"><i></i><i></i></div>
  <div style="text-align:right;font-size:8.5pt">페이지: 1</div>
  <table class="tbl" style="margin:0 0 1mm;border-top:1.5px solid var(--line)"><tr><th style="width:22mm">건 물 명</th><td class="l">{{ CX.building_name }} {% for u in d.units %}{{ u.label }}{% if not loop.last %}, {% endif %}{% endfor %}</td></tr></table>
  <table class="spec" style="height:205mm">
    <colgroup><col style="width:8mm"><col style="width:19mm"><col style="width:15mm"><col style="width:20mm"><col style="width:31mm"><col style="width:18mm"><col style="width:16mm"><col style="width:23mm"><col></colgroup>
    <tr><th rowspan="2">일련<br>번호</th><th rowspan="2">소재지</th><th rowspan="2">지 번</th><th rowspan="2">지 목<br>용 도</th><th rowspan="2">구 조<br>및<br>용도지역</th><th colspan="2">면 적 (㎡)</th><th rowspan="2">감정평가액</th><th rowspan="2">비 고</th></tr>
    <tr><th>공 부</th><th>사 정</th></tr>
    {% set nf = CX.floor_areas|length + 1 %}
    <tr><td rowspan="{{ nf }}"></td><td rowspan="{{ nf }}" style="padding-top:3mm">{{ CX.si_do }}<br>{{ CX.si_gun_gu }}<br>{{ CX.dong }}<br><br>[도로명주소]<br>{{ CX.road_short|join('<br>')|safe }}</td>
      <td rowspan="{{ nf }}" style="padding-top:3mm">{{ CX.jibun }}<br>{{ CX.building_name }}</td><td rowspan="{{ nf }}" style="padding-top:3mm">{{ CX.main_use }}</td>
      <td style="padding-top:3mm;padding-bottom:2mm">{{ CX.structure }}<br>{{ CX.roof }}<br>{{ CX.floors_text }}</td><td></td><td rowspan="{{ nf }}"></td><td rowspan="{{ nf }}"></td><td rowspan="{{ nf }}" class="pre">{{ CX.spec_note or '' }}</td></tr>
    {% for f in CX.floor_areas %}<tr><td>{{ f[0] }}</td><td class="r">{{ f[1]|area }}</td></tr>{% endfor %}
    <tr><td style="padding-top:5mm">1</td><td style="padding-top:5mm">{{ CX.dong }}</td><td style="padding-top:5mm">{{ CX.jibun }}</td><td style="padding-top:5mm">{{ CX.land_category }}</td><td style="padding-top:5mm">{{ CX.zoning }}</td><td class="r" style="padding-top:5mm">{{ CX.land_area|area }}</td><td></td><td></td><td></td></tr>
    {% for u in d.units %}{% set row = c.sc_rows[loop.index0] %}
    <tr><td style="padding-top:5mm">{{ u.code }}</td><td></td><td></td><td></td>
      <td style="padding-top:5mm">(내)<br>{{ u.structure }}<br>{{ u.label }}<br><br>1 {{ u.land_right_kind }}</td>
      <td class="r" style="padding-top:5mm"><br><br>{{ u.area|area }}<br><br><span style="display:inline-block;text-align:center;line-height:1.25">{{ u.land_right_num|area }}<br><span style="border-top:1px solid #333;display:block">{{ u.land_right_den|area }}</span></span></td>
      <td class="r" style="padding-top:5mm"><br><br>{{ u.area|area }}<br><br><br>{{ u.land_right_num|area }}</td>
      <td class="r" style="padding-top:5mm"><br><br>{{ row.value|won }}</td>
      <td class="l pre" style="padding-top:5mm"><br><br>{{ u.spec_note or '비준가액' }}</td></tr>
    {% endfor %}
    <tr class="total"><td></td><td>합 계</td><td></td><td></td><td></td><td></td><td></td><td class="r">₩{{ c.final|won }}.-</td><td></td></tr>
    <tr class="fill"><td></td><td></td><td></td><td></td><td colspan="3" style="padding-top:2mm"><span class="ihy">이하여백</span></td><td></td><td></td></tr>
  </table>
</section>

{# ============================================================ 산출근거 및 결정의견 #}
{% set pg = namespace(n=0) %}
{% macro op_open() -%}
<section class="page">
  <div class="docno"><span>{{ R.number }}</span><span class="brandmini">{{ O.name }}</span></div>
  <div class="opbar">감정평가액의 산출근거 및 결정 의견</div>
  <div class="opbody">
{%- endmacro %}
{% macro op_close(n) -%}
  </div>
  <div class="pfoot"><span>{{ O.name }}</span><span class="pn">- {{ n }} -</span><span>{{ R.number }}</span></div>
</section>
{%- endmacro %}

{# ---- p1 #}{% set pg.n = pg.n + 1 %}
{{ op_open() }}
<h2 class="chap">Ⅰ. 감정평가 개요</h2>
<h3 class="sec">1. 감정평가 목적</h3>
<p class="ind">본건은 {{ CX.si_do }} {{ CX.si_gun_gu }} {{ CX.dong }} 소재 {{ R.landmark }}에 위치하는 {{ R.property_desc }}으로서, {{ R.purpose_long }} 목적의 감정평가임.</p>
<h3 class="sec">2. 감정평가의 근거 및 기준</h3>
<p class="ind">본 감정평가는 「감정평가 및 감정평가사에 관한 법률」, 「감정평가에 관한 규칙」, 「감정평가 실무기준」 등 관계법령의 규정과 제반 감정평가이론을 적용하여 감정평가하였음.</p>
<h3 class="sec">3. 기준가치 및 감정평가조건</h3>
<p class="ind">가. 본건은 「감정평가에 관한 규칙」 제5조 제1항의 “{{ R.value_basis }}”를 기준으로 하였음.</p>
<p class="ind">나. {% if R.conditions in ['-', '', None] %}별도의 감정평가 조건은 없음.{% else %}{{ R.conditions }}{% endif %}</p>
<h3 class="sec">4. 기준시점 결정 및 그 이유</h3>
<p class="ind">「감정평가에 관한 규칙」 제9조 제2항에 따라 가격조사완료일인 <span class="hl">{{ R.base_date|long_date }}</span>을 기준시점으로 결정함.</p>
<h3 class="sec">5. 실지조사 실시기간 및 내용</h3>
<p class="ind">「감정평가에 관한 규칙」 제10조 제1항에 따라 본건 감정평가를 위한 실지조사는 {{ R.survey_date|long_date }}에 시행하여 대상물건의 현황 등을 직접 조사하고 가격자료를 수집하여 분석하였음.</p>
<h3 class="sec">6. 감정평가방법</h3>
<h4 class="sub">가. 감정평가 방식</h4>
<ol class="paren ind">
  <li>1) 원가방식 : 원가법 및 적산법 등 비용성의 원리에 기초한 감정평가방식</li>
  <li>2) 비교방식 : 공시지가기준법 및 거래사례비교법, 임대사례비교법 등 시장성의 원리에 기초한 감정평가방식</li>
  <li>3) 수익방식 : 수익환원법 및 수익분석법 등 수익성의 원리에 기초한 감정평가방식</li>
</ol>
{{ op_close(pg.n) }}

