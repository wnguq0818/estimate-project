<table class="tbl">
  <colgroup><col style="width:13%"><col><col style="width:11%"><col style="width:27%"></colgroup>
  <tr><th>조 건</th><th>세부항목({{ SC.use_label or '상업용' }})</th><th>격차율</th><th>비고</th></tr>
  {% for f in SC.factors %}<tr><td class="pre">{{ f.cond }}</td><td style="font-size:8.6pt">{{ f['items'] }}</td><td>{{ '%.2f'|format(f.rate) }}</td><td style="font-size:8.6pt">{{ f.note }}</td></tr>{% endfor %}
  <tr class="total"><td colspan="2">가치형성요인 비교치 (누계)</td><td>{{ '%.3f'|format(c.value_factor) }}</td><td>-</td></tr>
</table>
{{ op_close(pg.n) }}

{# ---- p7 #}{% set pg.n = pg.n + 1 %}
{{ op_open() }}
<h4 class="sub">사. 거래사례비교법에 의한 비준가액</h4>
<table class="tbl" style="font-size:8.6pt">
  <tr><th colspan="3">본 건</th>{% set RF = SC.region_factor is defined %}<th colspan="{{ 7 if RF else 6 }}">거래사례비교법에 따른 시산가액(단가) 산정</th><th rowspan="3">산정가액<br>(원)</th><th rowspan="3">시산가액<br>(원)</th></tr>
  <tr><th rowspan="2">일련<br>번호</th><th rowspan="2">{% if d.units[0].dong %}동/{% endif %}층/<br>호수</th><th rowspan="2">전유<br>면적(㎡)</th><th colspan="2">거래사례</th><th rowspan="2">사정<br>보정</th><th rowspan="2">시점<br>수정</th>{% if RF %}<th rowspan="2">지역<br>요인</th>{% endif %}<th rowspan="2">{{ '개별<br>요인'|safe if RF else '가치<br>형성<br>요인'|safe }}</th><th rowspan="2">산정단가<br>(원/전유㎡)</th></tr>
  <tr><th>번호</th><th>단가<br>(원/전유㎡)</th></tr>
  {% for r in c.sc_rows %}<tr><td>{{ r.unit.code }}</td><td>{% if r.unit.dong %}{{ r.unit.dong }}/<br>{% endif %}{{ r.unit.floor }}/<br>{{ r.unit.ho }}</td><td>{{ r.unit.area|area }}</td><td>{{ SC.selected }}</td><td>{{ r.case_unit|won }}</td><td>{{ '%.3f'|format(SC.situation_factor) }}</td><td>{{ '%.5f'|format(c.time_factor) }}</td>{% if RF %}<td>{{ '%.3f'|format(SC.region_factor) }}</td>{% endif %}<td>{{ '%.3f'|format(c.value_factor) }}</td><td>{{ r.unit_price|won }}</td><td>{{ r.computed|won }}</td><td>{{ r.value|won }}</td></tr>{% endfor %}
  <tr class="total"><td colspan="2">합계</td><td>{{ c.sc_total_area|area }}</td><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td>{% if RF %}<td>-</td>{% endif %}<td>-</td><td>-</td><td>{{ c.sc_total|won }}</td></tr>
</table>
<p class="note">※ 산정단가는 {{ SC.unit_round|won }}원 단위 반올림, 시산가액은 {{ SC.value_round|won }}원 미만 절사함.</p>
{% if INC %}
<h3 class="sec" style="margin-top:9mm">2. 수익환원법에 의한 시산가액 산출</h3>
<h4 class="sub">가. 개요</h4>
<p class="ind">본건은 수익성 부동산으로 본건의 적정임대수준을 추정하여 대상 부동산이 장래 산출할 것으로 기대되는 순수익을 환원율로 환원하여 대상물건의 가액을 산정함.</p>
<div class="formula">수익가액 = 기대 순수익 ÷ 환원이율</div>
<h4 class="sub">나. 가능총수익(PGI) 산정</h4>
<h5 class="ssub">1) 본건의 임대현황 및 적정임대수준</h5>
<table class="tbl">
  <tr><th rowspan="2">구분</th><th rowspan="2">이용상황</th><th colspan="3">임대내역(현황 임대료)</th><th rowspan="2">기타</th></tr>
  <tr><th>임대보증금(원)</th><th>월임대료(원)</th><th>월관리비(원)</th></tr>
  {% for r in INC.rent_status %}<tr><td>{{ r.label }}</td><td class="pre">{{ r.use }}</td><td>{{ r.deposit|won }}</td><td>{{ r.monthly|won }}</td><td>{{ r.mgmt|won }}</td><td class="pre">{{ r.note }}</td></tr>{% endfor %}
</table>
{{ op_close(pg.n) }}

{# ---- p8 #}{% set pg.n = pg.n + 1 %}
{{ op_open() }}
<h5 class="ssub">2) 본건의 적정임대수준</h5>
<table class="tbl">
  <tr><th style="width:20%">구 분</th><th>적정 임대수준(원/월)</th><th style="width:18%">비 고</th></tr>
  {% for r in INC.rent_levels %}<tr><td>{{ r.label }}</td><td>{{ r.range }}</td><td>{{ r.note }}</td></tr>{% endfor %}
</table>
<h5 class="ssub">3) 본건의 적용 임대료 결정</h5>
<table class="tbl">
  <tr><th rowspan="2" style="width:18%">기호</th><th colspan="3">적용 임대료</th><th rowspan="2" style="width:16%">비고</th></tr>
  <tr><th>보증금</th><th>월임대료</th><th>관리비</th></tr>
  {% for u in d.units %}<tr><td>{{ u.code }}</td><td>{{ (INC.applied.deposit or None)|won }}</td><td>{{ INC.applied.monthly|won }}</td><td>{{ (INC.applied.mgmt or None)|won }}</td><td>-</td></tr>{% endfor %}
</table>
<p class="note">※ 인근지역 내 형성되고 있는 유사건물의 임대료를 비교·검토하여 본건의 적용임대료를 결정하였음.<br>※ 관리비는 대상물건의 특성상 운영경비와 상계되는 점을 감안하여 별도 고려하지 아니함.</p>
<h5 class="ssub">4) 본건의 가능총수익(PGI) 산정</h5>
<table class="tbl">
  <tr><th>구분</th><th>보증금(원)</th><th>보증금<br>운용이익(원)</th><th>월임대료<br>(원)</th><th>연간임대료<br>(원)</th><th>월관리비<br>(원)</th><th>연간관리비<br>(원)</th><th>가능총소득<br>(PGI)(원)</th></tr>
  <tr><td>1</td><td>{{ (INC.applied.deposit or None)|won }}</td><td>{{ (CI.deposit_income or None)|won }}</td><td>{{ INC.applied.monthly|won }}</td><td>{{ CI.annual_rent|won }}</td><td>{{ (INC.applied.mgmt or None)|won }}</td><td>{{ (CI.annual_mgmt or None)|won }}</td><td>{{ CI.pgi|won }}</td></tr>
  <tr class="total"><td colspan="7">합 계</td><td>{{ CI.pgi|won }}</td></tr>
</table>
<h4 class="sub">다. 공실손실 상당액 및 대손충당금, 영업경비의 결정</h4>
<p class="ind">공실손실 상당액 및 대손충당금은 부동산 수요변동으로 인한 정상적인 공실률 및 불량부채로 인한 손실을 보전하기 위한 항목으로서, 인근 유사부동산의 공실비율 및 향후 수요예측에 따른 위험성을 감안하여 가능총수익(PGI)의 <b>&lt;{{ INC.vacancy_rate }}%&gt;</b> 수준으로 결정하였음.</p>
<table class="tbl">
  <tr><th rowspan="2">구분</th><th rowspan="2">지역</th><th colspan="{{ INC.vacancy_stats.labels|length }}">공실률(%)</th><th rowspan="2">연간<br>평균</th></tr>
  <tr>{% for l in INC.vacancy_stats.labels %}<th>{{ l }}</th>{% endfor %}</tr>
  <tr><td>{{ INC.vacancy_stats.kind }}</td><td>{{ INC.vacancy_stats.region }}</td>{% for v in INC.vacancy_stats['values'] %}<td>{{ '%.2f'|format(v) }}</td>{% endfor %}<td>{{ '%.2f'|format(CI.vacancy_avg) }}</td></tr>
</table>
<div class="src">(출처 : 한국부동산원 부동산통계시스템)</div>
<p class="ind">영업경비에는 제세공과금, 보험료, 유지관리비, 감가상각비 등 임대 부동산에 관리에 있어 발생하는 실제 비용을 말하며, 인근 유사부동산의 실제 영업경비 지출내역 등을 고려하여 유효총수익의 <b>&lt;{{ INC.opex_rate }}%&gt;</b> 수준으로 적용하였음.</p>
{{ op_close(pg.n) }}

{# ---- p9 #}{% set pg.n = pg.n + 1 %}
{{ op_open() }}
<h4 class="sub">라. 환원율의 결정</h4>
<h5 class="ssub">1) 금융시장의 금리</h5>
<table class="tbl">
  <tr><th>항목명</th><th>CD유통<br>수익률</th><th>국고채<br>(1년)</th><th>국고채<br>(3년)</th><th>국고채<br>(5년)</th><th>회사채<br>(장외3년,<br>AA-등급)</th><th>회사채<br>(장외3년,<br>BBB-등급)</th></tr>
  <tr><th>단위</th>{% for i in range(6) %}<th style="font-weight:400">연%</th>{% endfor %}</tr>
  {% for r in INC.interest.rows %}<tr>{% for v in r %}<td>{% if loop.first %}{{ v }}{% else %}{{ '%.2f'|format(v) }}{% endif %}</td>{% endfor %}</tr>{% endfor %}
</table>
<div class="src">(출처 : 한국은행 경제통계시스템)</div>
<h5 class="ssub">2) 집합상가의 수익률</h5>
{% set RT = INC.returns %}
<table class="tbl">
  <tr><th rowspan="2">구분</th><th rowspan="2">지역</th><th colspan="{{ RT.labels|length }}">투자수익률(%)</th><th rowspan="2">연간<br>환산</th><th colspan="{{ RT.labels|length }}">소득수익률(%)</th><th rowspan="2">연간<br>환산</th></tr>
  <tr>{% for l in RT.labels %}<th class="pre">{{ l }}</th>{% endfor %}{% for l in RT.labels %}<th class="pre">{{ l }}</th>{% endfor %}</tr>
  <tr><td>집합<br>상가</td><td>{{ INC.vacancy_stats.region }}</td>{% for v in RT.investment %}<td>{{ '%.2f'|format(v) }}</td>{% endfor %}<td>{{ '%.2f'|format(RT.investment_annual) }}%</td>{% for v in RT.income %}<td>{{ '%.2f'|format(v) }}</td>{% endfor %}<td>{{ '%.2f'|format(RT.income_annual) }}%</td></tr>
</table>
<div class="src">(출처 : 한국부동산원 부동산통계시스템)</div>
<h5 class="ssub">3) 환원율의 결정</h5>
<p class="ind">본건 환원율의 결정은 국토교통부에서 발표하는 “상업용 부동산 임대사례 조사보고서” 및 시중은행의 금리, CD 수익률 및 3년 만기 국고채 수익률, 본건 임대수익의 안정성과 평가목적을 종합적으로 고려하여 환원율은 <b>&lt;{{ INC.cap_rate }}%&gt;</b>로 결정함.</p>

{{ op_close(pg.n) }}

{# ---- p9b #}{% set pg.n = pg.n + 1 %}
{{ op_open() }}
<h4 class="sub">마. 수익환원법에 의한 시산가액</h4>
<div class="src">[단위 : 원]</div>
<table class="tbl">
  <colgroup><col style="width:38%"><col style="width:32%"><col></colgroup>
  <tr><th>항목</th><th>기호 ({% for u in d.units %}{{ u.code }}{% endfor %})</th><th>비고</th></tr>
  <tr><td>가능총수익(PGI)(a)</td><td>{{ CI.pgi|won }}</td><td>-</td></tr>
  <tr><td>공실손실상당액 및 대손충당금(V&amp;L)(b)</td><td>{{ CI.vl|won }}</td><td>가능총수익의 {{ INC.vacancy_rate }}% 적용</td></tr>
  <tr><td>기타수익(c)</td><td>{{ (CI.other or None)|won }}</td><td>별도의 기타소득 없음.</td></tr>
  <tr><td>유효총수익(EGI)(d=a-b+c)</td><td>{{ CI.egi|won }}</td><td>-</td></tr>
  <tr><td>영업경비(OE)(e)</td><td>{{ CI.oe|won }}</td><td>유효총수익의 {{ INC.opex_rate }}% 적용</td></tr>
  <tr><td>순수익(NOI)(f=d-e)</td><td>{{ CI.noi|won }}</td><td>-</td></tr>
  <tr><td>환원율(R)</td><td>{{ INC.cap_rate }}%</td><td>-</td></tr>
  <tr><td>수익가액(NOI/R)</td><td>{{ CI.value|won }}</td><td>{{ INC.value_round|won }}원 미만 절사</td></tr>
  <tr class="total"><td>시산가액</td><td>{{ CI.value|won }}</td><td>-</td></tr>
</table>
{% endif %}
{{ op_close(pg.n) }}

{# ---- p10: Ⅳ #}{% set pg.n = pg.n + 1 %}
{{ op_open() }}
<h2 class="chap">Ⅳ. 감정평가액의 결정에 관한 의견</h2>
<h3 class="sec">1. 시산가액</h3>
{% macro vtable(vals, total, bold=False) -%}
<table class="tbl">
  <colgroup><col style="width:11%"><col style="width:27%"><col style="width:20%"><col style="width:26%"><col></colgroup>
  <tr><th>기호</th><th>층, 호수</th><th>전유면적(㎡)</th><th>시산가액(원)</th><th>비고</th></tr>
  {% for u in d.units %}<tr><td>{{ u.code }}</td><td>{{ u.label }}</td><td>{{ u.area|area }}</td><td>{{ vals[loop.index0]|won }}</td><td>-</td></tr>{% endfor %}
  <tr class="total"><td colspan="3">합 계</td><td>{{ total|won }}</td><td>-</td></tr>
</table>
{%- endmacro %}
<h4 class="sub">가. 거래사례비교법에 의한 시산가액</h4>
{{ vtable(c.sc_rows|map(attribute='value')|list, c.sc_total) }}
{% if INC %}<h4 class="sub">나. 수익환원법에 의한 시산가액</h4>
{{ vtable([CI.value], CI.value) }}{% endif %}
<h3 class="sec">2. 시산가액의 조정 및 결정의견</h3>
<p class="ind">{{ d.opinion.reconciliation }}</p>
<h3 class="sec">3. 감정평가액의 결정</h3>
{{ vtable(c.sc_rows|map(attribute='value')|list, c.final) }}
<p style="text-align:right;margin-top:4mm;font-weight:700">감정평가액 : {{ c.final_korean }}원정 (₩{{ c.final|won }}.-)</p>
{{ op_close(pg.n) }}

{# ============================================================ 요항표 #}
<section class="page">
  <div class="docno"><span>{{ R.number }}</span><span class="brandmini">{{ O.name }}</span></div>
  <div class="form-title">({{ R.property_kind }}) 감정평가요항표</div>
  <div class="rule"><i></i><i></i></div>
  <table class="tbl" style="margin-top:6mm;font-size:9.6pt">
    <colgroup><col style="width:24%"><col></colgroup>
    <tr><th>기 재 사 항</th><th>내 역</th></tr>
    {% for k, v in d.summary_items %}<tr style="height:{{ 19 if d.summary_items|length <= 9 else 13 }}mm"><th class="pre" style="background:var(--soft-2);font-weight:700">{{ k }}</th><td class="l pre" style="line-height:1.75;padding:2.5mm 3mm">{{ v }}</td></tr>{% endfor %}
  </table>
</section>

{# ============================================================ 위치도 #}
{% for key, title in [('wide', '광 역 위 치 도'), ('detail', '상 세 위 치 도')] %}
<section class="page">
  <div class="docno"><span>{{ R.number }}</span><span class="brandmini">{{ O.name }}</span></div>
  <div class="form-title">{{ title }}</div>
  <div class="rule"><i></i><i></i></div>
  <table class="tbl" style="margin:4mm 0 3mm"><tr><th style="width:22%">소 재 지</th><td>{{ CX.jibun_address }} {{ CX.building_name }} {% for u in d.units %}{{ u.label }}{% if not loop.last %}, {% endif %}{% endfor %}</td></tr></table>
  <div class="mapbox">{% set src = img(d.maps[key]) %}{% if src %}<img src="{{ src }}">{% else %}<div class="ph">[ {{ title|replace(' ', '') }} 이미지 ]<br>data JSON의 maps.{{ key }} 에 이미지 경로를 넣으면 이 자리에 들어갑니다.</div>{% endif %}</div>
  <div class="legend"><span>[ 범 례 ]</span><span style="color:#c0392b">■ 본 건</span><span style="color:#3d6b2b">■ 평가사례</span><span style="color:#8e3b6e">■ 거래사례</span></div>
</section>
{% endfor %}

{# ============================================================ 사진 #}
{% set PP = d.photos_per_page or 2 %}
{% for i in range(0, d.photos|length, PP) %}
<section class="page">
  <div class="docno"><span>{{ R.number }}</span><span class="brandmini">{{ O.name }}</span></div>
  <div class="form-title" style="text-decoration:underline;text-underline-offset:6px">사 진 첨 부 용 지</div>
  <div class="rule"><i></i><i></i></div>
  {% if PP == 4 %}
  <div class="grid4">
    {% for p in d.photos[i:i+4] %}
    <div class="g"><div class="gh">{{ p.caption }}</div><div class="frame">{% set src = img(p.file) %}{% if src %}<img src="{{ src }}">{% else %}<div class="ph">[ 사진 ]<br>photos[{{ i + loop.index0 }}].file</div>{% endif %}</div></div>
    {% endfor %}
  </div>
  {% else %}
  <div class="photos">
    {% for p in d.photos[i:i+2] %}
    <div class="photo"><div class="frame">{% set src = img(p.file) %}{% if src %}<img src="{{ src }}">{% else %}<div class="ph">[ 사진 ]<br>photos[{{ i + loop.index0 }}].file</div>{% endif %}</div><div class="cap">{{ p.caption }}</div></div>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% endfor %}

</body>
</html>
